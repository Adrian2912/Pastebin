<!DOCTYPE html>
<html>
    <head>
        <title>Full message</title>
        <link rel="stylesheet" href="/stylesheets/fullMessagePageStyling.css">
    </head>
    <body>
        <p><%= message %></p>
        <div id="btns">
            <button id="editButton" onclick="enableEditor()">Edit</button>
            <button id="deleteButton" onclick="enableDeletion()">Delete</button>
        </div>
        <div id="editorSquare">
            <form action="/paste/<%= messageId %>/edit" method="POST">
                <input type="text" id="editorTextbox" name="content" value="<%= message %>">
                <input type="submit" value="Submit" id="editorSubmitButton">
            </form>
        </div>
        <div id="deletionSquare">
            <div id="deletionSquareWrapper">
                <h2>Are you sure you want to delete this paste?</h2>
                <div id="decisionButtons">
                    <form id="deletion" action="/paste/<%= messageId %>/delete" method="POST">
                        <input type="submit" value="Yes" id="deletionButton" name="content">
                    </form>
                    <button id="returningButton" onclick="returnToThePage()">No</button>
                </div>
            </div>
        </div>
        <script src="/javascripts/script.js"></script>
    </body>
</html>